    "steering": {
      "mapping": "steer_rad = steering / 32767 * vehicle.max_steer_rad, applied with NO slew inside the core",
      "steering": "i16 on the wire, -32767..32767; -32767 = full left, 32767 = full right, 0 = straight",
      "full_lock_rad": 0.55,
      "ticks_to_full_lock": 1,
      "verified": "measured: steering=16384 -> 0.275008 rad (0.5000 of full lock) after one tick; steering=32767 -> 0.550000 rad after one tick",
      "keyboard_convention_used": "the wheel is wound while the car stands still at 2/s towards full lock and 3/s towards centre (fractions of full lock per second), which is the web driver's rate, not the core's. The core imposes no floor.",
      "hold_ticks": 90
    },
    "lock_change": {
      "convention": "every leg of a line begins from a FULL STOP (clutch 255, brake 255) with the wheel already at that leg's lock, held for 90 ticks; a leg's arc depends only on distance and lock, never on speed",
      "why_stationary": "the path a leg traces is s -> d\u03b8 = dir*tan(delta)/wheelbase*ds, so steering while moving is safe in principle, but a stationary change makes the executed path equal the planned one to ~1 cm (measured on five legs of the bai 8 line)"
    }
  }
